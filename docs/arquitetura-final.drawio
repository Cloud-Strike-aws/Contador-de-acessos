,[0.75,1,0],[1,1,0],[0,0.25,0],[0,0.5,0],[0,0.75,0],[1,0.25,0],[1,0.5,0],[1,0.75,0]];outlineConnect=0;fontColor=#232F3E;fillColor=#C925D1;strokeColor=#ffffff;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;labelPosition=center;html=1;fontSize=12;fontStyle=0;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.cloud_development_kit;labelBackgroundColor=#FFFFFF;" value="AWS CDK (Python)&lt;br&gt;cdk synth / deploy" vertex="1"><mxGeometry x="140" y="30" width="78" height="78" as="geometry"/></mxCell><mxCell id="cfn" parent="iac" style="sketch=0;points=[[0,0,0],[0.25,0,0],[0.5,0,0],[0.75,0,0],[1,0,0],[0,1,0],[0.25,1,0],[0.5,1,0],[0.75,1,0],[1,1,0],[0,0.25,0],[0,0.5,0],[0,0.75,0],[1,0.25,0],[1,0.5,0],[1,0.75,0]];outlineConnect=0;fontColor=#232F3E;fillColor=#E7157B;strokeColor=#ffffff;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;labelPosition=center;html=1;fontSize=12;fontStyle=0;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.cloudformation;labelBackgroundColor=#FFFFFF;" value="AWS CloudFormation&lt;br&gt;Stack (rollback automático)" vertex="1"><mxGeometry x="460" y="30" width="78" height="78" as="geometry"/></mxCell><mxCell id="iam" parent="gov" style="sketch=0;outlineConnect=0;fontColor=#232F3E;gradientColor=none;fillColor=#DD344C;strokeColor=none;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=12;aspect=fixed;pointerEvents=1;shape=mxgraph.aws4.role;" value="" vertex="1"><mxGeometry x="40" y="250" width="78" height="44" as="geometry"/></mxCell><mxCell id="t_beh" parent="edgeg" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=11;fontColor=#232F3E;" value="&lt;b&gt;Comportamentos do CloudFront (mesmo domínio, sem CORS)&lt;/b&gt;&lt;br&gt;/*  →  S3 (OAC)&lt;br&gt;/api/hits  →  API Gateway (sem cache)&lt;br&gt;/api/count  →  API Gateway (cache ≈ 5 s)" vertex="1"><mxGeometry x="1110" y="80" width="380" height="100" as="geometry"/></mxCell><mxCell id="t_ddb" parent="region" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=11;fontColor=#232F3E;" value="Multi-AZ nativo (3 AZs),&lt;br&gt;sem custo extra. PITR ativo." vertex="1"><mxGeometry x="1368" y="385" width="190" height="60" as="geometry"/></mxCell><mxCell id="t_cost" parent="region" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=11;fontColor=#232F3E;" value="&lt;b&gt;Decisões de custo e alta disponibilidade&lt;/b&gt;&lt;br&gt;• Sem VPC, EC2, ALB e NAT: nenhum servidor, nenhum custo fixo de rede&lt;br&gt;• Todos os serviços já são Multi-AZ, sem custo extra&lt;br&gt;• Site em S3 privado (OAC): custo de centavos&lt;br&gt;• GET /api/count em cache de ≈ 5 s no CloudFront&lt;br&gt;• Um único WAF protege site e API; Lambdas fora da VPC (ARM)" vertex="1"><mxGeometry x="70" y="660" width="780" height="130" as="geometry"/></mxCell><mxCell id="t_iam" parent="gov" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=11;fontColor=#232F3E;" value="&lt;b&gt;IAM Roles — menor privilégio&lt;/b&gt;&lt;br&gt;API Gateway → sqs:SendMessage&lt;br&gt;Processor → sqs:Receive/Delete/&lt;br&gt;   GetQueueAttributes + dynamodb:UpdateItem&lt;br&gt;Read Counter → dynamodb:GetItem&lt;br&gt;CloudFront → s3:GetObject (OAC)" vertex="1"><mxGeometry x="140" y="240" width="420" height="150" as="geometry"/></mxCell><mxCell id="t_bud" parent="gov" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=11;fontColor=#232F3E;" value="&lt;b&gt;AWS Budgets → SNS: alerta de orçamento&lt;/b&gt;&lt;br&gt;Alarmes: DLQ &gt; 0, erros de Lambda, 5XX, idade da fila" vertex="1"><mxGeometry x="40" y="690" width="520" height="60" as="geometry"/></mxCell><mxCell id="t_leg" parent="acct" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=11;fontColor=#232F3E;" value="&lt;b&gt;Legenda&lt;/b&gt;&lt;br&gt;━━ Escrita (POST /api/hits)&lt;br&gt;━━ Leitura (GET /api/count)&lt;br&gt;━━ Acesso ao site estático&lt;br&gt;┅┅ DNS · logs · alarmes · implantação" vertex="1"><mxGeometry x="880" y="1242" width="330" height="110" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>